{
  "name": "boo",
  "version": "1.0.0",
  "description": "A starter theme for headless Ghost CMS",
  "author": "Sandeep Ramgolam",
  "private": true,
  "scripts": {
    "dev": "nuxt --port 6001",
    "localdev": "NUXT_HOST=192.168.100.156 nuxt --port 6002",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "test": "jest",
    "deploy-gh": "npm run generate && git add -A && git commit -m 'generated using npm run deploy-gh' &&  git push -u origin master"
  },
  "dependencies": {
    "@nuxtjs/dotenv": "^1.4.0",
    "@nuxtjs/svg": "^0.1.7",
    "@tryghost/content-api": "^1.3.10",
    "nuxt": "^2.18.1",
    "vue-filter-date-format": "^1.3.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "postcss": "^8.5.25"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^4.2.1",
    "@vue/test-utils": "^1.0.0-beta.33",
    "babel-jest": "^26.6.3",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-prettier": "^3.0.1",
    "jest": "^26.6.3",
    "postcss-nested": "^5.0.6",
    "prettier": "^1.16.4",
    "vue-jest": "^4.0.0-0"
  }
